# Production Environment Configuration
# This file is loaded when NODE_ENV=production

# Server Configuration
PORT=3000
HOST=0.0.0.0

# MOI Network Configuration
MOI_NETWORK_URL=https://voyage-rpc.moi.technology/mainnet/v2
MOI_NETWORK_ID=mainnet

# Intelligence Logic ID (deployed contract address)
MOI_INTELLIGENCE_LOGIC_ID=

# Use real adapter in production
USE_MOCK_ADAPTER=false

# Logging
LOG_LEVEL=info

# Write Request TTL (seconds)
WRITE_REQUEST_TTL_SECONDS=600
