{
  "name": "participant-intelligence-service",
  "version": "1.0.0",
  "description": "Participant state and authorization control plane for MOI-based agent systems",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "NODE_ENV=local tsx watch src/server.ts",
    "dev:dev": "NODE_ENV=development tsx watch src/server.ts",
    "dev:prod": "NODE_ENV=production tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "deploy:devnet": "tsx scripts/deploy-devnet.ts",
    "verify:devnet": "tsx scripts/verify-deployment.ts",
    "interact:devnet": "tsx scripts/interact-devnet.ts"
  },
  "keywords": [
    "moi",
    "participant",
    "intelligence",
    "authorization",
    "blockchain"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "js-moi-sdk": "0.7.0-rc10",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/supertest": "^7.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
