# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MOI Network Configuration
# For Public Devnet: https://dev.voyage-rpc.moi.technology/devnet/v2
MOI_NETWORK_URL=https://dev.voyage-rpc.moi.technology/devnet/v2
MOI_NETWORK_ID=devnet

# Intelligence Logic ID (deployed contract address)
# Get this after deploying the Intelligence.coco contract:
#   npm run deploy:devnet
MOI_INTELLIGENCE_LOGIC_ID=

# Use mock adapter for local development (set to "false" for real MOI network)
USE_MOCK_ADAPTER=true

# Logging
LOG_LEVEL=info

# Write Request TTL (seconds)
WRITE_REQUEST_TTL_SECONDS=600

# Deployment Configuration (for scripts)
# Your wallet mnemonic for deployment and interactions
# MOI_MNEMONIC=your twelve word mnemonic phrase here
# Optional: Custom devnet RPC endpoint
# MOI_DEVNET_RPC=https://dev.voyage-rpc.moi.technology/devnet/v2
